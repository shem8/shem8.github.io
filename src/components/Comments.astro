---
// The identifier keeps the original http:// address, which is how existing Disqus threads are stored.
const { path } = Astro.props as { path: string };
const threadUrl = `http://blog.shem.dev${path}`;
---
<section class="comments" aria-label="Comments">
  <div id="disqus_thread"></div>
  <script is:inline define:vars={{ threadUrl }}>
    window.disqus_config = function () { this.page.url = threadUrl; this.page.identifier = threadUrl; };
    var slot = document.getElementById('disqus_thread');
    var load = function () { var s = document.createElement('script'); s.src = 'https://shemblog.disqus.com/embed.js'; s.async = true; s.setAttribute('data-timestamp', +new Date()); document.body.appendChild(s); };
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { io.disconnect(); load(); } }, { rootMargin: '400px' });
      io.observe(slot);
    } else { load(); }
  </script>
</section>
